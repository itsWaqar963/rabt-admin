NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical Rabt Admin origin (no trailing slash). Private env — not NEXT_PUBLIC.
# Used on the server for absolute redirects. Client magic-link/reset uses window.location.origin.
# Local: http://localhost:3000
# Vercel: set APP_URL=https://rabt-admin.vercel.app as encrypted/plain env (not NEXT_PUBLIC).
# If unset on Vercel, falls back to https://$VERCEL_URL.
APP_URL=http://localhost:3000

# Operator: Supabase Dashboard → Authentication → URL Configuration
# - Site URL may stay the PWA (or set carefully to admin if preferred).
# - Redirect URLs allowlist MUST include exact callback URLs (no wildcards required if exact):
#     https://rabt-admin.vercel.app/auth/callback
#     http://localhost:3000/auth/callback
#   (or whatever port this admin app uses locally)
# - App intentionally omits query strings on redirectTo / emailRedirectTo so allowlist
#   exact-match works (e.g. ?next=... would miss allowlist → Supabase falls back to Site URL / PWA).
# - Post-login path defaults to /dashboard; password recovery uses a short-lived cookie.
# - Google provider: enable under Auth → Providers (shared project; already on for PWA).
# - No NEXT_PUBLIC_APP_URL — client uses window.location.origin; server uses APP_URL / VERCEL_URL.

# Production PWA origin (no trailing slash). Server POSTs /api/admin-broadcast here.
# Example: https://rabt.vercel.app  or  https://rabt-pwa.vercel.app
PWA_APP_URL=https://rabt-pwa.vercel.app

# Same value as rabt-pwa ADMIN_BROADCAST_SECRET (server-only; never NEXT_PUBLIC).
ADMIN_BROADCAST_SECRET=

# VAPID keys live on the PWA only (NEXT_PUBLIC_VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY).
# Admin does not send Web Push itself — it proxies to PWA with ADMIN_BROADCAST_SECRET.
# Subscriptions were created with the PWA’s NEXT_PUBLIC_VAPID_PUBLIC_KEY; changing VAPID
# rotates keys and invalidates all push_subscriptions (users must re-subscribe).
