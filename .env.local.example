NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical Rabt Admin origin (no trailing slash). Used for magic-link + password-reset redirects.
# Example production: https://rabt-admin.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator: Supabase Dashboard → Authentication → URL Configuration
# - Site URL may stay the PWA (or set carefully to admin if preferred).
# - Redirect URLs allowlist MUST include:
#     https://rabt-admin.vercel.app/auth/callback
#     http://localhost:3000/auth/callback
#   (or whatever port this admin app uses locally)
