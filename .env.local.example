NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical Rabt Admin origin (no trailing slash). Private env — not NEXT_PUBLIC.
# Used on the server for absolute redirects. Client magic-link/reset uses window.location.origin.
# Local: http://localhost:3000
# Vercel: set APP_URL=https://rabt-admin.vercel.app as encrypted/plain env (not NEXT_PUBLIC).
# If unset on Vercel, falls back to https://$VERCEL_URL.
APP_URL=http://localhost:3000

# Operator: Supabase Dashboard → Authentication → URL Configuration
# - Site URL may stay the PWA (or set carefully to admin if preferred).
# - Redirect URLs allowlist MUST include:
#     https://rabt-admin.vercel.app/auth/callback
#     http://localhost:3000/auth/callback
#   (or whatever port this admin app uses locally)
